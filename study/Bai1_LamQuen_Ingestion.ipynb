    "    ORDER BY count DESC\n",
    "''').df()\n",
    "\n",
    "display(df_passengers)\n",
    "\n",
    "most_common = df_passengers.iloc[0]\n",
    "print(f\"\\nMost common group: {most_common['passenger_count']} passenger(s) ({int(most_common['count']):,} trips)\")"
