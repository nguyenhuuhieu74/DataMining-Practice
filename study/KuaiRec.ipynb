    "\n",
    "def duck():\n",
    "    con = duckdb.connect()\n",
    "    con.execute(\"INSTALL httpfs; LOAD httpfs;\")\n",
    "    con.execute(f'''\n",
    "        CREATE OR REPLACE SECRET minio (\n",
    "            TYPE s3, \n",
    "            KEY_ID '{CFG[\"s3_key\"]}',\n",
    "            SECRET '{CFG[\"s3_secret\"]}', \n",
    "            ENDPOINT '{CFG[\"s3_endpoint\"]}',\n",
    "            USE_SSL false, \n",
    "            URL_STYLE 'path'\n",
    "        );\n",
    "    ''')\n",
    "    return con\n",
    "\n",
    "con = duck()\n",
    "print(\"Da khoi tao ket noi DuckDB thanh cong.\")"
